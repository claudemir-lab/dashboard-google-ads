<!DOCTYP</script> html> <html lang="pt-BR" translate="no"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <meta name="google" content="notranslate"> <title>Painel Google Ads — Neurosaber</title> <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script></script></script></script><script>
const SUPABASE_URL = "https://bbitajwmcapohixocavn.supabase.co";
const API_KEY = "sb_publishable_fNQDTEEbDQvMBbK8M4Dqeg_j-5QF2sS";

const fmtBRL = v => v.toLocaleString("pt-BR", { style:"currency", currency:"BRL" });
const fmtInt = v => v.toLocaleString("pt-BR");
const fmtDate = iso => {
  const d = new Date(iso + "T00:00:00");
  return d.toLocaleDateString("pt-BR");
};

async function fetchRows() {
  const url = SUPABASE_URL + "/rest/v1/gads_dashboard?select=data,nome_campanha,produto_nome,investimento,faturamento,cliques,impressoes,itens_no_carrinho,quantidade_vendida,roas,roi&order=data.asc";
  const res = await fetch(url, {
    headers: {
      apikey: API_KEY,
      Authorization: "Bearer " + API_KEY,
      Accept: "application/json"
    }
  });
  if (!res.ok) throw new Error("HTTP " + res.status + " — " + await res.text());
  return res.json();
}

function filter(rows, period) {
  if (period === "all") return rows;
  const today = new Date(); today.setHours(0,0,0,0);
  let start, end = today;
  if (period === "today") {
    start = new Date(today);
  } else if (period === "yesterday") {
    start = new Date(today); start.setDate(start.getDate() - 1);
    end = new Date(start);
  } else if (period === "this-month") {
    start = new Date(today.getFullYear(), today.getMonth(), 1);
  } else if (period === "last-month") {
    start = new Date(today.getFullYear(), today.getMonth() - 1, 1);
    end = new Date(today.getFullYear(), today.getMonth(), 0);
  } else {
    const n = parseInt(period, 10);
    start = new Date(today); start.setDate(start.getDate() - (n - 1));
  }
  return rows.filter(r => {
    const rd = new Date(r.data + "T00:00:00");
    return rd >= start && rd <= end;
  });
}

function build(rows) {
  const isCamp = r => r.produto_nome === "Geral / Campanha";
  const campRows = rows.filter(isCamp);
  const prodRows = rows.filter(r => !isCamp(r));
  const sum = (arr, f) => arr.reduce((s,r)=>s+Number(f(r)||0),0);

  const inv = sum(campRows, r=>r.investimento);
  const fat = sum(campRows, r=>r.faturamento);
  const fatProd = sum(prodRows, r=>r.faturamento);
  const cli = sum(campRows, r=>r.cliques);
  const imp = sum(campRows, r=>r.impressoes);
  const car = sum(campRows, r=>r.itens_no_carrinho);
  const ven = sum(campRows, r=>r.quantidade_vendida);
  const venProd = sum(prodRows, r=>r.quantidade_vendida);
  const roas = inv > 0 ? fat / inv : 0;
  const roi = inv > 0 ? ((fat - inv)/inv)*100 : 0;
  const ctr = imp > 0 ? (cli/imp)*100 : 0;
  const cpc = cli > 0 ? inv/cli : 0;

  const byDay = {};
  rows.forEach(r => {
    const d = r.data;
    if (!byDay[d]) byDay[d] = { inv:0, fat:0, fatProd:0, cli:0, imp:0 };
    if (isCamp(r)) {
      byDay[d].inv += Number(r.investimento||0);
      byDay[d].fat += Number(r.faturamento||0);
      byDay[d].cli += Number(r.cliques||0);
      byDay[d].imp += Number(r.impressoes||0);
    } else {
      byDay[d].fatProd += Number(r.faturamento||0);
    }
  });
  const daysIso = Object.keys(byDay).sort();
  const days = daysIso.map(fmtDate);
  const invest = daysIso.map(d => byDay[d].inv);
  const fatura = daysIso.map(d => byDay[d].fat);
  const faturaProd = daysIso.map(d => byDay[d].fatProd);
  const roasArr = daysIso.map(d => byDay[d].inv > 0 ? byDay[d].fat / byDay[d].inv : 0);
  const cliques = daysIso.map(d => byDay[d].cli);
  const impr = daysIso.map(d => byDay[d].imp);

  const kpis = [
    { label:"Investimento", value:fmtBRL(inv), sub:"" },
    { label: prodRows.length ? "Faturamento (Campanha)" : "Faturamento", value:fmtBRL(fat), sub:"" },
    ...(prodRows.length ? [{ label:"Faturamento (Produtos)", value:fmtBRL(fatProd), sub:"" }] : []),
    { label:"ROAS", value:roas.toFixed(2)+"x", sub:"", cls: roas>=1?"up":"down" },
    { label:"ROI", value:roi.toFixed(0)+"%", sub:"", cls: roi>=0?"up":"down" },
    { label:"Cliques", value:fmtInt(cli), sub:"" },
    { label:"CPC médio", value:fmtBRL(cpc), sub:"" },
    { label:"CTR", value:ctr.toFixed(2)+"%", sub:"" },
    { label:"Impressões", value:fmtInt(imp), sub:"" },
    { label:"Conversões", value:fmtInt(ven), sub:"" },
    ...(prodRows.length ? [{ label:"Unidades vendidas", value:fmtInt(venProd), sub:"" }] : [])
  ];

  document.getElementById("content").innerHTML =
    '<div class="grid">' + kpis.map(k =>
      '<div class="kpi"><div class="label">'+k.label+'</div>'+
      '<div class="value '+(k.cls||"")+'">'+k.value+'</div><div class="sub">'+k.sub+'</div></div>'
    ).join("") + '</div>' +

    '<div class="charts">' +
      '<div class="chart-card"><h3>Investimento x Faturamento (por dia)</h3><div class="chart-box"><canvas id="chTrend"></canvas></div></div>' +
      '<div class="chart-card"><h3>ROAS por dia</h3><div class="chart-box"><canvas id="chRoas"></canvas></div></div>' +
      '<div class="chart-card wide"><h3>Cliques e impressões (por dia)</h3><div class="chart-box"><canvas id="chTraffic"></canvas></div></div>' +
    '</div>' +

    '<div class="table-wrap">' +
      '<table><thead><tr><th>Data</th><th>Campanha</th><th>Invest.</th><th>Fat.</th><th>ROAS</th><th>ROI</th><th>Cliques</th><th>Impr.</th><th>Conversões</th></tr></thead><tbody>' +
      [...campRows].reverse().map(r =>
        '<tr><td>'+fmtDate(r.data)+'</td><td>'+r.nome_campanha+'</td>'+
        '<td>'+fmtBRL(Number(r.investimento))+'</td><td>'+fmtBRL(Number(r.faturamento))+'</td>'+
        '<td>'+Number(r.roas).toFixed(2)+'x</td><td>'+Number(r.roi).toFixed(0)+'%</td>'+
        '<td>'+fmtInt(r.cliques)+'</td><td>'+fmtInt(r.impressoes)+'</td><td>'+fmtInt(r.quantidade_vendida)+'</td></tr>'
      ).join("") +
      '</tbody></table>' +
      '<div class="totals">'+
        '<div><b>Período:</b> '+days[0]+' a '+days[days.length-1]+' &nbsp;·&nbsp; <b>'+daysIso.length+'</b> dias &nbsp;·&nbsp; <b>'+fmtBRL(inv)+'</b> investido &nbsp;·&nbsp; campanha <b>'+fmtBRL(fat)+'</b>'+(prodRows.length ? ' &nbsp;·&nbsp; produtos <b>'+fmtBRL(fatProd)+'</b>' : '')+' &nbsp;·&nbsp; <b>'+roas.toFixed(2)+'x</b> ROAS médio</div>'+
      '</div>' +
    '</div>';

  const trendSeries = [
    { label:"Investimento", data:invest, color:"#6c5ce7", fill:true },
    { label:"Faturamento", data:fatura, color:"#2ecc71", fill:true }
  ];
 if (prodRows.length > 0) trendSeries.push({ label:"Faturamento (Produtos)", data:faturaProd, color:"#f1c40f", fill:false });
  makeChart("chTrend", days, trendSeries);
  makeChart("chRoas", days, [
    { label:"ROAS", data:roasArr, color:"#f39c12", fill:false, step:true }
  ]);
  makeChart("chTraffic", days, [
    { label:"Cliques", data:cliques, color:"#f1c40f", fill:false },
    { label:"Impressões", data:impr, color:"#3498db", fill:false }
  ], null, 2);
}

let charts = {};
function makeChart(id, labels, series, yLabel, barIdx) {
  if (charts[id]) charts[id].destroy();
  const datasets = series.map(s => ({
    label: s.label,
    data: s.data,
    borderColor: s.color,
    backgroundColor: s.fill ? s.color + "33" : s.color,
    fill: !!s.fill,
    stepped: !!s.step,
    type: barIdx === 2 ? "bar" : (id === "chTraffic" ? "bar" : "line"),
    borderRadius: 4,
    tension: 0.3
  }));
  charts[id] = new Chart(document.getElementById(id), {
    data: { labels, datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode:"index", intersect:false },
      plugins: { legend: { labels: { color:"#8b93ab", boxWidth:12 } } },
      scales: {
        x: { ticks:{ color:"#8b93ab", maxRotation:60, maxTicksLimit:15 }, grid:{ color:"#232c47" } },
        y: { ticks:{ color:"#8b93ab" }, grid:{ color:"#232c47" } }
      }
    }
  });
}

async function loadData() {
  const el = document.getElementById("content");
  el.className = "loader";
  el.textContent = "Carregando dados...";
  try {
    const all = await fetchRows();
    if (all.length === 0) {
      el.className = "loader";
      el.textContent = "Nenhum registro encontrado no Supabase.";
      return;
    }
    const rows = filter(all, document.getElementById("period").value);
    if (rows.length === 0) {
      el.className = "loader";
      el.textContent = "Nenhum registro no período selecionado.";
      return;
    }
    build(rows);
  } catch (e) {
    el.className = "loader";
    el.textContent = "Erro ao carregar: " + e.message;
    console.error(e);
  }
}

document.getElementById("period").add
const SUPABASE_URL = "https://bbitajwmcapohixocavn.supabase.co";
const API_KEY = "sb_publishable_fNQDTEEbDQvMBbK8M4Dqeg_j-5QF2sS";

