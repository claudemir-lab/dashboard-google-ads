# SUPABASE
SUPABASE_URL=https://[SUA_URL].supabase.co
SUPABASE_KEY=[SUA_KEY]
SUPABASE_TABLE=gads_dashboard

# GOOGLE ADS API (Necessário apenas para execução via script Python)
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_DEVELOPER_TOKEN=seu_developer_token
GOOGLE_ADS_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=seu_client_secret
GOOGLE_ADS_REFRESH_TOKEN=seu_refresh_token

# SHOPIFY (Etapa 2 - shopify_daily_sync.js)
# Credenciais: Dev Dashboard -> app -> Settings -> Client ID / Client secret
# Escopos: read_orders (read_products e read_customers opcionais)
SHOPIFY_STORE=sualoja.myshopify.com
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_TZ=America/Sao_Paulo
DAYS_BACK=90
